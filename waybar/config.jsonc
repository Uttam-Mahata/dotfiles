{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 3,
  "margin-left": 14,
  "margin-right": 14,
  "reload_style_on_change": true,

  "modules-left": ["group/launch"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["group/sys"],

  "group/launch": {
    "orientation": "horizontal",
    "modules": ["custom/arch", "hyprland/workspaces"]
  },

  "group/sys": {
    "orientation": "horizontal",
    "modules": ["clock", "custom/wg", "custom/tailscale", "bluetooth", "network", "custom/display", "battery", "custom/power"]
  },

  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "wofi --show drun"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 18,
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": { "^\\s*$": "" }
  },

  "clock": {
    "format": "{0:%I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "months": "<span color='#ffffff'><b>{}</b></span>",
        "weekdays": "<span color='#8c96a0'><b>{}</b></span>",
        "days": "<span color='#ffffff'>{}</span>",
        "today": "<span color='#1793d1'><b><u>[{}]</u></b></span>"
      }
    }
  },

  "custom/wg": {
    "exec": "~/.config/waybar/scripts/wg.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/wg.sh toggle"
  },

  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale-exit.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/tailscale-exit.sh menu",
    "on-click-right": "~/.config/waybar/scripts/tailscale-exit.sh toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
  },

  "custom/display": {
    "exec": "$HOME/.config/waybar/scripts/display.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "$HOME/.local/bin/display-mode menu",
    "tooltip": true
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  },

  "battery": {
    "bat": "BAT1",
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "{icon} {capacity}%",
    "tooltip-format": "{timeTo} ({power} W)",
    "format-icons": {
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    }
  }
}
