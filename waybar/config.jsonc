{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 3,
  "margin-left": 14,
  "margin-right": 14,
  "reload_style_on_change": true,

  "modules-left":   ["group/launch", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["custom/recording", "mpris", "tray", "group/sys"],

  "group/launch": {
    "orientation": "horizontal",
    "modules": ["custom/arch", "hyprland/workspaces"]
  },

  "group/sys": {
    "orientation": "horizontal",
    "modules": [
      "custom/wg", "custom/tailscale", "bluetooth", "network",
      "wireplumber", "custom/display", "battery", "custom/power"
    ]
  },

  "custom/arch": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "~/.local/bin/wofi-menu launcher --show drun",
    "on-click-right": "~/.local/bin/keybinds"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  "hyprland/window": {
    "format": "{class}",
    "icon": true,
    "icon-size": 16,
    "max-length": 32,
    "separate-outputs": true,
    "tooltip": true,
    "rewrite": {
      "^\\s*$": "",
      "^firefox$": "Firefox",
      "^kitty$": "Terminal",
      "^dropterm$": "Terminal",
      "^org\\.pulseaudio\\.pavucontrol$": "Volume"
    }
  },

  "clock": {
    "format": "{:%a %d %b  %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#ffffff'><b>{}</b></span>",
        "weekdays": "<span color='#8c96a0'><b>{}</b></span>",
        "days":     "<span color='#ffffff'>{}</span>",
        "today":    "<span color='#1793d1'><b><u>[{}]</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_down", "on-scroll-down": "shift_up", "on-click-right": "mode" }
  },

  "custom/recording": {
    "exec": "~/.config/waybar/scripts/recording.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 12,
    "on-click": "~/.local/bin/screenrec"
  },

  "mpris": {
    "format": "{status_icon} {title}",
    "format-stopped": "",
    "title-len": 24,
    "status-icons": { "playing": "󰏤", "paused": "󰐊" },
    "tooltip-format": "{player}: {artist} — {title}\nClick: play/pause · Scroll: next/previous",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  "custom/wg": {
    "exec": "~/.config/waybar/scripts/wg.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 13,
    "on-click": "~/.config/waybar/scripts/wg.sh menu",
    "on-click-right": "~/.config/waybar/scripts/wg.sh toggle"
  },

  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale-exit.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/tailscale-exit.sh menu",
    "on-click-right": "~/.config/waybar/scripts/tailscale-exit.sh toggle"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
    "on-click-right": "blueman-manager"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "nm-connection-editor"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "scroll-step": 5,
    "max-volume": 100,
    "tooltip-format": "{node_name}: {volume}%\nClick: mute · Right-click: mixer",
    "on-click": "~/.local/bin/osd volume mute",
    "on-click-right": "pavucontrol"
  },

  "custom/display": {
    "exec": "$HOME/.config/waybar/scripts/display.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 10,
    "on-click": "$HOME/.local/bin/display-mode menu",
    "tooltip": true
  },

  "battery": {
    "bat": "BAT1",
    "interval": 30,
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "{icon} {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "{icon} {capacity}%",
    "tooltip-format": "{timeTo} ({power} W)",
    "format-icons": {
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
    }
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power menu (Super+X)",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
