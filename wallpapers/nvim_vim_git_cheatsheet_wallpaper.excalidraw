    {
      "id": "0524ad56",
      "type": "text",
      "x": 683,
      "y": 209,
      "width": 554,
      "height": 375,
      "angle": 0,
      "strokeColor": "#c0caf5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
