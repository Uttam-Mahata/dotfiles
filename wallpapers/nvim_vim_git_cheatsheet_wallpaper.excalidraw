      "roundness": null,
      "seed": 1008,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<C-h>                Navigate left pane (Vim & Tmux)\n<C-j>                Navigate down pane (Vim & Tmux)\n<C-k>                Navigate up pane (Vim & Tmux)\n<C-l>                Navigate right pane (Vim & Tmux)\n<leader>sv           Split window vertical (:vsplit)\n<leader>sh           Split window horizontal (:split)\n<leader>sc           Close active split window (:close)\n<leader>=            Equalize split sizes (<C-w>=)\n<C-d> / <C-u>        Half-page scroll down / up (centered zz)\nn / N                Next / prev search match (centered nzzzv)\ngj / gk              Move by visual line on wrapped text\n<Esc> / <leader>/    Clear search highlight (:nohlsearch)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "<C-h>                Navigate left pane (Vim & Tmux)\n<C-j>                Navigate down pane (Vim & Tmux)\n<C-k>                Navigate up pane (Vim & Tmux)\n<C-l>                Navigate right pane (Vim & Tmux)\n<leader>sv           Split window vertical (:vsplit)\n<leader>sh           Split window horizontal (:split)\n<leader>sc           Close active split window (:close)\n<leader>=            Equalize split sizes (<C-w>=)\n<C-d> / <C-u>        Half-page scroll down / up (centered zz)\nn / N                Next / prev search match (centered nzzzv)\ngj / gk              Move by visual line on wrapped text\n<Esc> / <leader>/    Clear search highlight (:nohlsearch)",
      "lineHeight": 1.5
    },
