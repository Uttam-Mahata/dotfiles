      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<leader>gs           Git status dashboard (:Git / Neogit)\n<leader>gd           Git diff split against index (:Gdiffsplit)\n<leader>gb           Git blame line annotations (:Git blame)\n<leader>gc           Git commit history log (:Commits)\n]h / [h              Jump to next / previous git hunk\n<leader>gh           Preview git hunk diff inline\ns (in status)        Stage file or hunk under cursor\nu (in status)        Unstage file or hunk under cursor\ncc (in status)       Create git commit (:Git commit)\ngp (in status)       Git push to remote\ngl (in status)       Git pull from remote\nX (in status)        Discard unstaged changes in file",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "<leader>gs           Git status dashboard (:Git / Neogit)\n<leader>gd           Git diff split against index (:Gdiffsplit)\n<leader>gb           Git blame line annotations (:Git blame)\n<leader>gc           Git commit history log (:Commits)\n]h / [h              Jump to next / previous git hunk\n<leader>gh           Preview git hunk diff inline\ns (in status)        Stage file or hunk under cursor\nu (in status)        Unstage file or hunk under cursor\ncc (in status)       Create git commit (:Git commit)\ngp (in status)       Git push to remote\ngl (in status)       Git pull from remote\nX (in status)        Discard unstaged changes in file",
      "lineHeight": 1.5
    },
