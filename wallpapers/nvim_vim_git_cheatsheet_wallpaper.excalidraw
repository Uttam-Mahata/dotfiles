      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<leader><Space>      Find files in project (:Files)\n<leader>ff           Find files alternate shortcut\n<leader>fg / <leader>/ Live Grep search project text (:Rg)\n<leader>, / <leader>fb Find and switch open buffers (:Buffers)\n<leader>fr           Recent file history (:History)\n<leader>e            Toggle file explorer tree (Neo-tree/Netrw)\n<leader>fh           Search help documentation tags\n<leader>fk           Search keymaps & shortcuts (:Maps)\n<leader>fc           Search command list (:Commands)\n<leader>ev           Quick edit config (:vsplit $MYVIMRC)\n<leader>tw           Trim trailing whitespace in file\n<leader>n / <leader>sp Toggle relative numbers / Spellcheck",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "<leader><Space>      Find files in project (:Files)\n<leader>ff           Find files alternate shortcut\n<leader>fg / <leader>/ Live Grep search project text (:Rg)\n<leader>, / <leader>fb Find and switch open buffers (:Buffers)\n<leader>fr           Recent file history (:History)\n<leader>e            Toggle file explorer tree (Neo-tree/Netrw)\n<leader>fh           Search help documentation tags\n<leader>fk           Search keymaps & shortcuts (:Maps)\n<leader>fc           Search command list (:Commands)\n<leader>ev           Quick edit config (:vsplit $MYVIMRC)\n<leader>tw           Trim trailing whitespace in file\n<leader>n / <leader>sp Toggle relative numbers / Spellcheck",
      "lineHeight": 1.5
    },
