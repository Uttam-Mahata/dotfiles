      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "<A-j> / <A-k>        Move line up / down (Normal mode)\n<A-j> / <A-k>        Move selected block up/down (Visual)\n< / >                Indent left / right (retains selection)\nY                    Yank to end of line (matches D and C)\np (visual)           Paste without overwriting register (\"_dP)\n<leader>d            Delete without yanking (\"_d)\ngcc / gc             Toggle line / block comment\nys{motion}{c}        Add surround quotes/brackets (e.g. ysiw\")\ncs{old}{new}         Change surround quotes/brackets (e.g. cs\"')\nds{char}             Delete surround delimiter (e.g. ds\")\nci\" / ca\"            Change inside / around quotes\ndi( / da(            Delete inside / around parentheses",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 10,
      "containerId": null,
      "originalText": "<A-j> / <A-k>        Move line up / down (Normal mode)\n<A-j> / <A-k>        Move selected block up/down (Visual)\n< / >                Indent left / right (retains selection)\nY                    Yank to end of line (matches D and C)\np (visual)           Paste without overwriting register (\"_dP)\n<leader>d            Delete without yanking (\"_d)\ngcc / gc             Toggle line / block comment\nys{motion}{c}        Add surround quotes/brackets (e.g. ysiw\")\ncs{old}{new}         Change surround quotes/brackets (e.g. cs\"')\nds{char}             Delete surround delimiter (e.g. ds\")\nci\" / ca\"            Change inside / around quotes\ndi( / da(            Delete inside / around parentheses",
      "lineHeight": 1.5
    },
