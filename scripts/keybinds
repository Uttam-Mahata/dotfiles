#!/usr/bin/env bash
# Searchable keybind cheatsheet (Super + /). The list is generated by hypr/modules/binds.lua on every reload.
sheet="${XDG_CACHE_HOME:-$HOME/.cache}/hypr/keybinds.txt"
[ -s "$sheet" ] || { notify-send "Keybinds" "Cheatsheet not generated yet — run: hyprctl reload"; exit 1; }
pkill -x wofi && exit 0
wofi --dmenu --cache-file /dev/null -p "Search keybinds" --width 720 --height 560 \
     --style "$HOME/.config/wofi/style.css" < "$sheet" >/dev/null
